# Copy to .env and supply local credentials. Prisma and the server load backend/.env.
# Existing environment variables take precedence.
DATABASE_URL="sqlserver://localhost:1433;database=ciee;user=sa;password=REPLACE_LOCALLY;encrypt=true;trustServerCertificate=true"


# Limites para extração de texto em PDF.
PDF_MAX_PAGES=20
PDF_PARSE_TIMEOUT_MS=15000
PDF_PARSE_CONCURRENCY=2
