{
  "name": "desafio-ciee-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.6.2 <12"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "multer": "2.5.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.624",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "glob": "14.0.4"
  },
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:e2e": "jest --config jest.e2e.config.cjs --runInBand",
    "check": "npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/main/Server.ts",
    "start": "node dist/main/Server.js",
    "seed": "prisma db seed"
  }
}
