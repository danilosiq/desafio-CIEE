# Copy to .env.docker; use a unique local password with uppercase, lowercase, digits and symbols.
# Do not use semicolons or dollar signs in the password (Compose/SQL connection-string delimiters).
MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
MSSQL_DATABASE=ciee
SQLSERVER_PORT=1433
BACKEND_PORT=3333

# Ollama executado pelo Compose.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_CONTEXT=4096
OLLAMA_CONCURRENCY=1
OLLAMA_TIMEOUT_MS=120000
