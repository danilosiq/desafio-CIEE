generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlserver"
}

model Resume {
  id                  String   @id @default(uuid()) @db.UniqueIdentifier
  fullName            String   @db.NVarChar(200)
  email               String   @unique @db.NVarChar(320)
  phone               String?  @db.NVarChar(50)
  interestArea        String?  @db.NVarChar(200)
  professionalSummary String?  @db.NVarChar(Max)
  createdAt           DateTime @default(now()) @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2
}

model ResumeProcessingJob {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  status    String   @default("Processing") @db.NVarChar(10)
  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2
}

model AreaOfExpertise {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  name        String   @unique @db.NVarChar(200)
  description String   @db.NVarChar(Max)
  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2
}
